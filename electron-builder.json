{
  "appId": "com.nourhayik.quotalens",
  "productName": "QuotaLens",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "electron/**/*",
    "bin/**/*",
    "package.json"
  ],
  "linux": {
    "target": [
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "category": "Development",
    "icon": "assets/icon.png",
    "maintainer": "Nour Hayik <n-4i@hotmail.com>",
    "synopsis": "Local AI coding limits and quota dashboard"
  },
  "deb": {
    "afterInstall": "electron/deb-after-install.sh",
    "afterRemove": "electron/deb-after-remove.sh"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "extraFiles": [
      {
        "from": "electron/bin/",
        "to": "."
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "QuotaLens",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "include": "electron/installer.nsh"
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "identity": null,
    "icon": "assets/icon.icns",
    "category": "public.app-category.developer-tools"
  }
}
