{
  "appId": "com.nourhayik.quotalens",
  "productName": "QuotaLens",
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "assets/**/*", "electron/**/*", "bin/**/*", "package.json"],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "category": "Development",
    "icon": "assets/icon.png",
    "maintainer": "Nour Hayik <n-4i@hotmail.com>",
    "synopsis": "Local AI coding limits and quota dashboard"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "QuotaLens",
    "include": "electron/installer.nsh"
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/icon.icns",
    "category": "public.app-category.developer-tools"
  }
}
